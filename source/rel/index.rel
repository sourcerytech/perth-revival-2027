("attr.htmlImported.1_1_1_1_1_1.0", "node", "node.htmlImported.1_1_1_1_1_1")
("attr.htmlImported.1_1_1_1_1_1.0", "name", "class")
("attr.htmlImported.1_1_1_1_1_1.0", "value", "intro-body")
("node.htmlImported.1_1_1_1_1_1_0", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_1_0", "tag", "p")
("attr.htmlImported.1_1_1_1_1_1_0.0", "isa", "DomAttr")
("attr.htmlImported.1_1_1_1_1_1_0.0", "node", "node.htmlImported.1_1_1_1_1_1_0")
("attr.htmlImported.1_1_1_1_1_1_0.0", "name", "class")
("attr.htmlImported.1_1_1_1_1_1_0.0", "value", "lead")
("text.htmlImported.1_1_1_1_1_1_0_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_1_0_0.0", "text", "Perth Encounter is a night of prayer, worship, lament, reconciliation and practical mercy beside the Derbarl Yerrigan / Swan River.")
("edge.htmlImported.1_1_1_1_1_1_0_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_0_0.0", "parent", "node.htmlImported.1_1_1_1_1_1_0")
("edge.htmlImported.1_1_1_1_1_1_0_0.0", "child", "text.htmlImported.1_1_1_1_1_1_0_0.0")
("edge.htmlImported.1_1_1_1_1_1_0_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_1_1_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_0.0", "parent", "node.htmlImported.1_1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_1_0.0", "child", "node.htmlImported.1_1_1_1_1_1_0")
("edge.htmlImported.1_1_1_1_1_1_0.0", "order", "1")
("node.htmlImported.1_1_1_1_1_1_1", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_1_1", "tag", "p")
("text.htmlImported.1_1_1_1_1_1_1_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_1_1_0.0", "text", "It grew from one person’s search for God, truth, love and responsible power. It is now offered beyond one person: to Perth’s churches, communities, musicians and neighbours as one night given to God.")
("edge.htmlImported.1_1_1_1_1_1_1_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_1_0.0", "parent", "node.htmlImported.1_1_1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_1_1_0.0", "child", "text.htmlImported.1_1_1_1_1_1_1_0.0")
("edge.htmlImported.1_1_1_1_1_1_1_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_1_1_1.1", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_1.1", "parent", "node.htmlImported.1_1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_1_1.1", "child", "node.htmlImported.1_1_1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_1_1.1", "order", "2")
("node.htmlImported.1_1_1_1_1_1_2", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_1_2", "tag", "p")
("text.htmlImported.1_1_1_1_1_1_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_1_2_0.0", "text", "Its kenotic centre is simple: power is most trustworthy when it serves rather than dominates. We take revelation seriously without turning testimony into control, and we make room for doubt, conscience and honest disagreement.")
("edge.htmlImported.1_1_1_1_1_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_2_0.0", "parent", "node.htmlImported.1_1_1_1_1_1_2")
("edge.htmlImported.1_1_1_1_1_1_2_0.0", "child", "text.htmlImported.1_1_1_1_1_1_2_0.0")
("edge.htmlImported.1_1_1_1_1_1_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_1_1_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_2.2", "parent", "node.htmlImported.1_1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_1_2.2", "child", "node.htmlImported.1_1_1_1_1_1_2")
("edge.htmlImported.1_1_1_1_1_1_2.2", "order", "3")
("node.htmlImported.1_1_1_1_1_1_3", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_1_3", "tag", "div")
("attr.htmlImported.1_1_1_1_1_1_3.0", "isa", "DomAttr")
("attr.htmlImported.1_1_1_1_1_1_3.0", "node", "node.htmlImported.1_1_1_1_1_1_3")
("attr.htmlImported.1_1_1_1_1_1_3.0", "name", "class")
("attr.htmlImported.1_1_1_1_1_1_3.0", "value", "pull-quote")
("text.htmlImported.1_1_1_1_1_1_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_1_3_0.0", "text", "“The power of revival is not how many people fall down, but how many burdens are lifted when we stand.”")
("edge.htmlImported.1_1_1_1_1_1_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_1_3_0.0", "parent", "node.htmlImported.1_1_1_1_1_1_3")
