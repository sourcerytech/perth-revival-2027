("text.htmlImported.1_1_1_5_2_2_1_0.0", "text", "Keep one another safe")
("edge.htmlImported.1_1_1_5_2_2_1_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_5_2_2_1_0.0", "parent", "node.htmlImported.1_1_1_5_2_2_1")
