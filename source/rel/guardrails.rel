("edge.htmlImported.1_1_1_1_0_3_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_0_3.3", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_0_3.3", "parent", "node.htmlImported.1_1_1_1_0")
("edge.htmlImported.1_1_1_1_0_3.3", "child", "node.htmlImported.1_1_1_1_0_3")
("edge.htmlImported.1_1_1_1_0_3.3", "order", "4")
