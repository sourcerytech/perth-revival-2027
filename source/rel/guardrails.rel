("node.htmlImported.1_1_1_1_0_4", "tag", "p")
("text.htmlImported.1_1_1_1_0_4_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_0_4_0.0", "text", "“You claim revelation, so people must obey.” We answer: testimony can be honoured while conscience remains free.")
