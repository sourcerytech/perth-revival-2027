("text.htmlImported.1_1_1_3_6_1_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_6_1_2_0.0", "text", "and cannot say.")
("edge.htmlImported.1_1_1_3_6_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_1_2_0.0", "parent", "node.htmlImported.1_1_1_3_6_1_2")
("edge.htmlImported.1_1_1_3_6_1_2_0.0", "child", "text.htmlImported.1_1_1_3_6_1_2_0.0")
("edge.htmlImported.1_1_1_3_6_1_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_6_1_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_1_2.2", "parent", "node.htmlImported.1_1_1_3_6_1")
("edge.htmlImported.1_1_1_3_6_1_2.2", "child", "node.htmlImported.1_1_1_3_6_1_2")
("edge.htmlImported.1_1_1_3_6_1_2.2", "order", "3")
("edge.htmlImported.1_1_1_3_6_1.1", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_1.1", "parent", "node.htmlImported.1_1_1_3_6")
("edge.htmlImported.1_1_1_3_6_1.1", "child", "node.htmlImported.1_1_1_3_6_1")
("edge.htmlImported.1_1_1_3_6_1.1", "order", "2")
("node.htmlImported.1_1_1_3_6_2", "isa", "DomNode")
("node.htmlImported.1_1_1_3_6_2", "tag", "p")
("text.htmlImported.1_1_1_3_6_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_6_2_0.0", "text", "I can speak about my own experience, memory and interpretation. I cannot establish the external cause of that experience by testimony alone. I cannot ask another person to surrender conscience, safety, money, relationship or freedom because I believe something strongly.")
("edge.htmlImported.1_1_1_3_6_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_2_0.0", "parent", "node.htmlImported.1_1_1_3_6_2")
("edge.htmlImported.1_1_1_3_6_2_0.0", "child", "text.htmlImported.1_1_1_3_6_2_0.0")
("edge.htmlImported.1_1_1_3_6_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_6_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_2.2", "parent", "node.htmlImported.1_1_1_3_6")
("edge.htmlImported.1_1_1_3_6_2.2", "child", "node.htmlImported.1_1_1_3_6_2")
("edge.htmlImported.1_1_1_3_6_2.2", "order", "3")
("node.htmlImported.1_1_1_3_6_3", "isa", "DomNode")
("node.htmlImported.1_1_1_3_6_3", "tag", "p")
("text.htmlImported.1_1_1_3_6_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_6_3_0.0", "text", "If the account has value, it should produce humility, repair, useful work and greater freedom in others. If it produces domination, secrecy or fear, it has failed its own test.")
("edge.htmlImported.1_1_1_3_6_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_3_0.0", "parent", "node.htmlImported.1_1_1_3_6_3")
("edge.htmlImported.1_1_1_3_6_3_0.0", "child", "text.htmlImported.1_1_1_3_6_3_0.0")
("edge.htmlImported.1_1_1_3_6_3_0.0", "order", "1")
