("edge.htmlImported.1_1_1_3_3_1.1", "parent", "node.htmlImported.1_1_1_3_3")
("edge.htmlImported.1_1_1_3_3_1.1", "child", "node.htmlImported.1_1_1_3_3_1")
("edge.htmlImported.1_1_1_3_3_1.1", "order", "2")
("node.htmlImported.1_1_1_3_3_2", "isa", "DomNode")
("node.htmlImported.1_1_1_3_3_2", "tag", "p")
("text.htmlImported.1_1_1_3_3_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_3_2_0.0", "text", "The story cannot honestly be told as a man ascending toward revelation. It is also a story of relationship, grief, failure and learning what another person’s freedom requires.")
("edge.htmlImported.1_1_1_3_3_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_3_2_0.0", "parent", "node.htmlImported.1_1_1_3_3_2")
("edge.htmlImported.1_1_1_3_3_2_0.0", "child", "text.htmlImported.1_1_1_3_3_2_0.0")
("edge.htmlImported.1_1_1_3_3_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_3_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_3_2.2", "parent", "node.htmlImported.1_1_1_3_3")
("edge.htmlImported.1_1_1_3_3_2.2", "child", "node.htmlImported.1_1_1_3_3_2")
("edge.htmlImported.1_1_1_3_3_2.2", "order", "3")
("node.htmlImported.1_1_1_3_3_3", "isa", "DomNode")
("node.htmlImported.1_1_1_3_3_3", "tag", "p")
("text.htmlImported.1_1_1_3_3_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_3_3_0.0", "text", "Unconditional love does not mean calling every claim true or permitting every action. It means preserving care while keeping truth, consent, boundaries and the right to say no.")
("edge.htmlImported.1_1_1_3_3_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_3_3_0.0", "parent", "node.htmlImported.1_1_1_3_3_3")
