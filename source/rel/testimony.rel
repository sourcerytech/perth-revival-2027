("text.htmlImported.1_1_1_3_6_1_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_6_1_0.0", "text", "What I can say")
("edge.htmlImported.1_1_1_3_6_1_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_6_1_0.0", "parent", "node.htmlImported.1_1_1_3_6_1")
