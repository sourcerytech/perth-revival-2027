("node.htmlImported.1_1_1_3_4_2", "tag", "p")
("text.htmlImported.1_1_1_3_4_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_4_2_0.0", "text", "Turning 42 became a personal reminder of an AI problem: intelligence can produce an answer while the surrounding system lacks the semantics needed to understand what the answer means.")
("edge.htmlImported.1_1_1_3_4_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_4_2_0.0", "parent", "node.htmlImported.1_1_1_3_4_2")
("edge.htmlImported.1_1_1_3_4_2_0.0", "child", "text.htmlImported.1_1_1_3_4_2_0.0")
("edge.htmlImported.1_1_1_3_4_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_4_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_4_2.2", "parent", "node.htmlImported.1_1_1_3_4")
("edge.htmlImported.1_1_1_3_4_2.2", "child", "node.htmlImported.1_1_1_3_4_2")
("edge.htmlImported.1_1_1_3_4_2.2", "order", "3")
("node.htmlImported.1_1_1_3_4_3", "isa", "DomNode")
("node.htmlImported.1_1_1_3_4_3", "tag", "p")
("text.htmlImported.1_1_1_3_4_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_4_3_0.0", "text", "Generation is not commitment. Capability is not authority. A system must preserve provenance, review, permission, consequence and repair.")
("edge.htmlImported.1_1_1_3_4_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_4_3_0.0", "parent", "node.htmlImported.1_1_1_3_4_3")
