("node.htmlImported.1_1_1_3_1_3", "tag", "p")
("text.htmlImported.1_1_1_3_1_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_1_3_0.0", "text", "The statement is part of my testimony. It is not an entitlement to authority over anyone else.")
