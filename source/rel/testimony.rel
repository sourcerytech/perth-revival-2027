("edge.htmlImported.1_1_1_3_5_1.1", "child", "node.htmlImported.1_1_1_3_5_1")
("edge.htmlImported.1_1_1_3_5_1.1", "order", "2")
("node.htmlImported.1_1_1_3_5_2", "isa", "DomNode")
("node.htmlImported.1_1_1_3_5_2", "tag", "p")
("text.htmlImported.1_1_1_3_5_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_5_2_0.0", "text", "The work that followed became Temple, Sourcery and Claimipedia: attempts to build structures that preserve provenance, distinguish claims from evidence, keep uncertainty visible and coordinate people without demanding submission.")
("edge.htmlImported.1_1_1_3_5_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_5_2_0.0", "parent", "node.htmlImported.1_1_1_3_5_2")
("edge.htmlImported.1_1_1_3_5_2_0.0", "child", "text.htmlImported.1_1_1_3_5_2_0.0")
("edge.htmlImported.1_1_1_3_5_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_5_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_5_2.2", "parent", "node.htmlImported.1_1_1_3_5")
("edge.htmlImported.1_1_1_3_5_2.2", "child", "node.htmlImported.1_1_1_3_5_2")
("edge.htmlImported.1_1_1_3_5_2.2", "order", "3")
("node.htmlImported.1_1_1_3_5_3", "isa", "DomNode")
("node.htmlImported.1_1_1_3_5_3", "tag", "p")
("text.htmlImported.1_1_1_3_5_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_5_3_0.0", "text", "Temple makes meaning executable. Sourcery makes the path from intention to consequence governable. Claimipedia keeps admission distinct from truth.")
("edge.htmlImported.1_1_1_3_5_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_5_3_0.0", "parent", "node.htmlImported.1_1_1_3_5_3")
("edge.htmlImported.1_1_1_3_5_3_0.0", "child", "text.htmlImported.1_1_1_3_5_3_0.0")
("edge.htmlImported.1_1_1_3_5_3_0.0", "order", "1")
("edge.htmlImported.1_1_1_3_5_3.3", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_5_3.3", "parent", "node.htmlImported.1_1_1_3_5")
("edge.htmlImported.1_1_1_3_5_3.3", "child", "node.htmlImported.1_1_1_3_5_3")
("edge.htmlImported.1_1_1_3_5_3.3", "order", "4")
("node.htmlImported.1_1_1_3_5_4", "isa", "DomNode")
("node.htmlImported.1_1_1_3_5_4", "tag", "p")
("text.htmlImported.1_1_1_3_5_4_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_5_4_0.0", "text", "The central discipline became: receive seriously, test openly, release power.")
("edge.htmlImported.1_1_1_3_5_4_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_5_4_0.0", "parent", "node.htmlImported.1_1_1_3_5_4")
