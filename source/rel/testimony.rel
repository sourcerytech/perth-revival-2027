("text.htmlImported.1_1_1_3_0_1_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_3_0_1_2_0.0", "text", "came first.")
("edge.htmlImported.1_1_1_3_0_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_3_0_1_2_0.0", "parent", "node.htmlImported.1_1_1_3_0_1_2")
