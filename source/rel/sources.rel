("text.htmlImported.1_1_1_1_1_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_3_0.0", "text", "That is why this event makes room for doubt, protects consent, refuses to blame people for suffering, and looks for fruit rather than spectacle.")
