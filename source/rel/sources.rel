("text.htmlImported.1_1_1_1_0_1_2_0.0", "text", "what changes.")
("edge.htmlImported.1_1_1_1_0_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_0_1_2_0.0", "parent", "node.htmlImported.1_1_1_1_0_1_2")
