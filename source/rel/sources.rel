("text.htmlImported.1_1_1_1_1_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_2_0.0", "text", "The framework is not being offered as proof of God, a guarantee of healing, or a mechanism that controls people. It is a discipline for keeping power answerable to love.")
("edge.htmlImported.1_1_1_1_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_2_0.0", "parent", "node.htmlImported.1_1_1_1_1_2")
