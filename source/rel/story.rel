("edge.htmlImported.1_1_1_1_2_1.1", "parent", "node.htmlImported.1_1_1_1_2")
("edge.htmlImported.1_1_1_1_2_1.1", "child", "node.htmlImported.1_1_1_1_2_1")
("edge.htmlImported.1_1_1_1_2_1.1", "order", "2")
("node.htmlImported.1_1_1_1_2_2", "isa", "DomNode")
("node.htmlImported.1_1_1_1_2_2", "tag", "p")
("text.htmlImported.1_1_1_1_2_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_2_2_0.0", "text", "The wider corpus includes reported testimony associated with Chris Bledsoe and Aaron’s reported Easter 2026 experience. These are preserved as testimony and unresolved interpretation—not as established proof of supernatural causation.")
("edge.htmlImported.1_1_1_1_2_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_2_2_0.0", "parent", "node.htmlImported.1_1_1_1_2_2")
("edge.htmlImported.1_1_1_1_2_2_0.0", "child", "text.htmlImported.1_1_1_1_2_2_0.0")
("edge.htmlImported.1_1_1_1_2_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_2_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_2_2.2", "parent", "node.htmlImported.1_1_1_1_2")
("edge.htmlImported.1_1_1_1_2_2.2", "child", "node.htmlImported.1_1_1_1_2_2")
("edge.htmlImported.1_1_1_1_2_2.2", "order", "3")
("node.htmlImported.1_1_1_1_2_3", "isa", "DomNode")
("node.htmlImported.1_1_1_1_2_3", "tag", "p")
("text.htmlImported.1_1_1_1_2_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_2_3_0.0", "text", "The test is what follows: does the claim preserve conscience, consent, truthfulness and the freedom of others?")
("edge.htmlImported.1_1_1_1_2_3_0.0", "isa", "DomChild")
