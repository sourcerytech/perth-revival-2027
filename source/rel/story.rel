("node.htmlImported.1_1_1_1_1_2", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_2", "tag", "p")
("text.htmlImported.1_1_1_1_1_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_2_0.0", "text", "This is not Aaron’s new religion. It is an invitation for churches, communities, musicians, families and neighbours to bring their best to God, then leave the centre open.")
("edge.htmlImported.1_1_1_1_1_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_2_0.0", "parent", "node.htmlImported.1_1_1_1_1_2")
("edge.htmlImported.1_1_1_1_1_2_0.0", "child", "text.htmlImported.1_1_1_1_1_2_0.0")
("edge.htmlImported.1_1_1_1_1_2_0.0", "order", "1")
("edge.htmlImported.1_1_1_1_1_2.2", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_2.2", "parent", "node.htmlImported.1_1_1_1_1")
("edge.htmlImported.1_1_1_1_1_2.2", "child", "node.htmlImported.1_1_1_1_1_2")
("edge.htmlImported.1_1_1_1_1_2.2", "order", "3")
("node.htmlImported.1_1_1_1_1_3", "isa", "DomNode")
("node.htmlImported.1_1_1_1_1_3", "tag", "p")
("text.htmlImported.1_1_1_1_1_3_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_1_3_0.0", "text", "No one has to join a movement, adopt a vocabulary or agree with every idea. People can worship, listen, serve, question or simply come in peace.")
("edge.htmlImported.1_1_1_1_1_3_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_1_3_0.0", "parent", "node.htmlImported.1_1_1_1_1_3")
