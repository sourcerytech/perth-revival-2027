("edge.htmlImported.1_1_1_1_3_1.1", "order", "2")
("node.htmlImported.1_1_1_1_3_2", "isa", "DomNode")
("node.htmlImported.1_1_1_1_3_2", "tag", "p")
("text.htmlImported.1_1_1_1_3_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_3_2_0.0", "text", "If anything has been given to us, it is not a throne. It is a responsibility. The most kenotic response is to make the work open, correctable and useful to people who may never remember who made it.")
("edge.htmlImported.1_1_1_1_3_2_0.0", "isa", "DomChild")
