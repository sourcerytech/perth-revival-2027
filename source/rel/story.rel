("node.htmlImported.1_1_1_1_0_2", "tag", "p")
("text.htmlImported.1_1_1_1_0_2_0.0", "isa", "DomText")
("text.htmlImported.1_1_1_1_0_2_0.0", "text", "The gathering grew from questions about God, suffering, love, marriage, knowledge and responsibility. Aaron’s account is offered as testimony—not as a command, and not as proof that anyone else must believe.")
("edge.htmlImported.1_1_1_1_0_2_0.0", "isa", "DomChild")
("edge.htmlImported.1_1_1_1_0_2_0.0", "parent", "node.htmlImported.1_1_1_1_0_2")
