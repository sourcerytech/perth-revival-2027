// Claimipedia-style semantic document projection grammar for this site.
// These facts decide the projection; the MJS module supplies generic DOM
// construction and host-safe escaping only.
("grammar.perthEncounter.document", "isa", "ProjectionGrammar")
("grammar.perthEncounter.document", "protocol", "claimipedia-semantic-document-grammar/1")
("grammar.perthEncounter.document", "production", "production.Document")
("grammar.perthEncounter.document", "invariant", "one main landmark")
("grammar.perthEncounter.document", "invariant", "one site header")
("grammar.perthEncounter.document", "invariant", "one primary navigation")
("grammar.perthEncounter.document", "invariant", "one breadcrumb")
("grammar.perthEncounter.document", "invariant", "one h1")
("grammar.perthEncounter.document", "invariant", "no skipped heading level")
("grammar.perthEncounter.document", "invariant", "no duplicate element id")
("grammar.perthEncounter.document", "invariant", "no presentational nodes")
("production.Document", "isa", "DocumentProduction")
("production.Document", "rhs", "SkipLink?")
("production.Document", "rhs", "SiteHeader")
("production.Document", "rhs", "Main")
("production.Document", "rhs", "SiteFooter?")
("grammar.perthEncounter.document", "template", "template.home")
("grammar.perthEncounter.document", "template", "template.document")
("grammar.perthEncounter.document", "mapping", "mapping.section")
("grammar.perthEncounter.document", "mapping", "mapping.processStage")
("grammar.perthEncounter.document", "mapping", "mapping.principle")
("grammar.perthEncounter.document", "mapping", "mapping.list")
("template.home", "isa", "PageTemplate")
("template.home", "pageRole", "home")
("template.home", "hero", "hero.home")
("template.home", "section", "region.home.invitation")
("template.home", "section", "region.home.architecture")
("template.home", "section", "region.home.posture")
("template.home", "section", "region.home.process")
("template.home", "section", "region.home.kenotic")
("template.home", "section", "region.home.join")
("template.home", "section", "region.home.sources")
("template.document", "isa", "PageTemplate")
("template.document", "pageRole", "default")
("template.document", "hero", "hero.document")
("template.document", "section", "region.document")
("hero.home", "isa", "ProjectionRegion")
("hero.home", "tag", "section")
("hero.home", "class", "hero")
("hero.document", "isa", "ProjectionRegion")
("hero.document", "tag", "header")
("hero.document", "class", "source-hero")
("region.home.invitation", "isa", "ProjectionRegion")
("region.home.invitation", "sourceRole", "invitation")
("region.home.invitation", "tag", "section")
("region.home.invitation", "class", "intro section")
("region.home.invitation", "id", "why")
("region.home.architecture", "isa", "ProjectionRegion")
("region.home.architecture", "sourceRole", "architecture")
("region.home.architecture", "tag", "section")
("region.home.architecture", "class", "architecture section section-dark")
("region.home.architecture", "id", "architecture")
("region.home.posture", "isa", "ProjectionRegion")
("region.home.posture", "sourceRole", "posture")
("region.home.posture", "tag", "section")
("region.home.posture", "class", "section section-dark")
("region.home.process", "isa", "ProjectionRegion")
("region.home.process", "sourceRole", "process")
("region.home.process", "tag", "section")
("region.home.process", "class", "flow section")
("region.home.process", "id", "flow")
("region.home.kenotic", "isa", "ProjectionRegion")
("region.home.kenotic", "sourceRole", "kenotic")
("region.home.kenotic", "tag", "section")
("region.home.kenotic", "class", "algebra section")
("region.home.kenotic", "id", "algebra")
("region.home.join", "isa", "ProjectionRegion")
("region.home.join", "sourceRole", "join")
("region.home.join", "tag", "section")
("region.home.join", "class", "join section")
("region.home.join", "id", "join")
("region.home.join", "containsForm", "true")
("region.home.sources", "isa", "ProjectionRegion")
("region.home.sources", "sourceRole", "sources")
("region.home.sources", "tag", "section")
("region.home.sources", "class", "sources section")
("region.home.sources", "id", "sources")
("region.document", "isa", "ProjectionRegion")
("region.document", "sourceRole", "*")
("region.document", "tag", "article")
("mapping.section", "isa", "SemanticElementMapping")
("mapping.section", "sourceType", "Section")
("mapping.section", "tag", "section")
("mapping.section", "headingTag", "h2")
("mapping.section", "paragraphTag", "p")
("mapping.processStage", "isa", "SemanticElementMapping")
("mapping.processStage", "sourceType", "ProcessStage")
("mapping.processStage", "tag", "article")
("mapping.processStage", "class", "timeline-item")
("mapping.processStage", "collectionClass", "timeline")
("mapping.processStage", "headingTag", "h3")
("mapping.processStage", "paragraphTag", "p")
("mapping.processStage", "timeTag", "time")
("mapping.principle", "isa", "SemanticElementMapping")
("mapping.principle", "sourceType", "Principle")
("mapping.principle", "tag", "article")
("mapping.principle", "class", "principle-card")
("mapping.principle", "collectionClass", "principles-grid")
("mapping.principle", "headingTag", "h3")
("mapping.principle", "paragraphTag", "p")
("mapping.list", "isa", "SemanticElementMapping")
("mapping.list", "sourceType", "ItemCollection")
("mapping.list", "tag", "div")
("mapping.commonsItem", "isa", "SemanticElementMapping")
("mapping.commonsItem", "sourceType", "CommonsItem")
("mapping.commonsItem", "tag", "div")
("mapping.commonsItem", "headingTag", "b")
("mapping.commonsItem", "paragraphTag", "span")
// Reference layout mappings used by the Sites version.
("mapping.architectureCard", "isa", "SemanticElementMapping")
("mapping.architectureCard", "sourceType", "ArchitectureCard")
("mapping.architectureCard", "tag", "a")
("mapping.architectureCard", "class", "architecture-card")
("mapping.algebraNode", "isa", "SemanticElementMapping")
("mapping.algebraNode", "sourceType", "Principle")
("mapping.algebraNode", "tag", "article")
("mapping.algebraNode", "class", "algebra-node")
("mapping.sourceLink", "isa", "SemanticElementMapping")
("mapping.sourceLink", "sourceType", "SourceLink")
("mapping.sourceLink", "tag", "a")
("mapping.sourceLink", "class", "source-link")
