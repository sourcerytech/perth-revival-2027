// Browser process algebra for the public event surface.
// Effects name host capabilities; they are compiled into the browser adapter.
("process.browser", "isa", "Process")
("process.browser", "name", "Perth Encounter browser process")
("process.browser", "entry", "state.browser.idle")
("process.browser", "configuration", "config.browser.signup")
("config.browser.signup", "isa", "ProcessConfiguration")
("config.browser.signup", "endpoint", "https://perth-revival-signup.fragrant-brook-4404.workers.dev")
("config.browser.signup", "source", "perth-revival-2027")
("config.browser.signup", "formSelector", "#interest-form")
("config.browser.signup", "noteSelector", "#form-note")
("config.browser.signup", "menuSelector", ".menu-toggle")
("config.browser.signup", "navSelector", "#site-nav")
("config.browser.signup", "emailSelector", "#email")
("config.browser.signup", "consentSelector", "#consent")
("config.browser.signup", "sendingMessage", "Sending your interest…")
("config.browser.signup", "successMessage", "Thank you — your interest is received. We will be in touch with event updates.")
("config.browser.signup", "defaultError", "We could not complete that just now. Please try again in a moment.")
("config.browser.signup", "successColor", "#51361e")
("config.browser.signup", "errorColor", "#8d3028")
("state.browser.idle", "isa", "ProcessState")
("state.browser.idle", "name", "Ready")
("state.browser.idle", "process", "process.browser")
("state.browser.idle", "transition", "transition.browser.menu")
("state.browser.idle", "transition", "transition.browser.submit")
("transition.browser.menu", "isa", "ProcessTransition")
("transition.browser.menu", "process", "process.browser")
("transition.browser.menu", "from", "state.browser.idle")
("transition.browser.menu", "event", "menu.clicked")
("transition.browser.menu", "to", "state.browser.idle")
("transition.browser.menu", "effect", "effect.browser.menu.toggle")
("effect.browser.menu.toggle", "isa", "HostEffect")
("effect.browser.menu.toggle", "capability", "browser.dom")
("effect.browser.menu.toggle", "operation", "toggleMenu")
("transition.browser.submit", "isa", "ProcessTransition")
("transition.browser.submit", "process", "process.browser")
("transition.browser.submit", "from", "state.browser.idle")
("transition.browser.submit", "event", "signup.submitted")
("transition.browser.submit", "to", "state.browser.sending")
("transition.browser.submit", "effect", "effect.browser.signup.send")
("state.browser.sending", "isa", "ProcessState")
("state.browser.sending", "name", "Sending")
("state.browser.sending", "process", "process.browser")
("state.browser.sending", "transition", "transition.browser.success")
("state.browser.sending", "transition", "transition.browser.failure")
("transition.browser.success", "isa", "ProcessTransition")
("transition.browser.success", "process", "process.browser")
("transition.browser.success", "from", "state.browser.sending")
("transition.browser.success", "event", "signup.succeeded")
("transition.browser.success", "to", "state.browser.idle")
("transition.browser.success", "effect", "effect.browser.signup.success")
("transition.browser.failure", "isa", "ProcessTransition")
("transition.browser.failure", "process", "process.browser")
("transition.browser.failure", "from", "state.browser.sending")
("transition.browser.failure", "event", "signup.failed")
("transition.browser.failure", "to", "state.browser.idle")
("transition.browser.failure", "effect", "effect.browser.signup.failure")
("effect.browser.signup.send", "isa", "HostEffect")
("effect.browser.signup.send", "capability", "browser.network")
("effect.browser.signup.send", "operation", "postJson")
("effect.browser.signup.success", "isa", "HostEffect")
("effect.browser.signup.success", "capability", "browser.dom")
("effect.browser.signup.success", "operation", "showSuccessAndReset")
("effect.browser.signup.failure", "isa", "HostEffect")
("effect.browser.signup.failure", "capability", "browser.dom")
("effect.browser.signup.failure", "operation", "showFailure")
