("node.begin", "label", "01 · BEGIN")
("node.begin", "heading", "Make a welcome")
("node.begin", "prose", "There is room for the hopeful, the doubtful, the grieving and the tired. No one has to perform belief to belong.")
("node.present", "isa", "Principle")
("node.present", "label", "02 · STAY PRESENT")
("node.present", "heading", "Receive this place")
("node.present", "prose", "We honour Perth, its waters, its peoples and its stories. We arrive as guests, not owners.")
("node.protect", "isa", "Principle")
("node.protect", "label", "03 · PROTECT")
("node.protect", "heading", "Keep one another safe")
("node.protect", "prose", "Love does not consume another person's freedom. Consent, safeguarding, dignity and honest boundaries matter.")
("node.listen", "isa", "Principle")
("node.listen", "label", "04 · LISTEN")
("node.listen", "heading", "Let love move")
("node.listen", "prose", "Prayer, music, silence and testimony become a way of listening—without rushing to fix, explain or control.")
("node.release", "isa", "Principle")
("node.release", "label", "05 · RELEASE")
("node.release", "heading", "Give up the centre")
("node.release", "prose", "At 7:07, leaders step back. We release the need to impress, dominate or produce a spectacle.")
("node.return", "isa", "Principle")
("node.return", "label", "06 · RETURN")
("node.return", "heading", "Look for the fruit")
("node.return", "prose", "We return to ordinary life carrying repair: a safer home, a shared meal, a hard apology, a neighbour remembered.")
