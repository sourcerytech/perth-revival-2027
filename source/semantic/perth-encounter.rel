("page.commons", "kicker", "The commons")
("page.commons", "heading", "Open tools. Shared work.")
("page.commons", "intro", "The event is a gathering; the commons is what keeps generating practical good after the lights go down.")
("page.commons", "section", "section.commons.tools")
("page.commons", "section", "section.commons.open")
("section.commons.tools", "isa", "Section")
("section.commons.tools", "page", "page.commons")
("section.commons.tools", "label", "What is being built")
("section.commons.tools", "heading", "A practical layer for local care")
("section.commons.tools", "prose", "Sourcery helps turn shared intentions into repeatable tools: invitations, volunteer pathways, social posts, follow-up, records of what helped and honest reports of what did not.")
("section.commons.open", "isa", "Section")
("section.commons.open", "page", "page.commons")
("section.commons.open", "label", "Open by design")
("section.commons.open", "heading", "The surplus belongs to the work")
("section.commons.open", "prose", "Finances, decisions, limits and learnings should be visible enough to earn trust. Operational independence protects the work; relational openness keeps it human.")

("page.guardrails", "isa", "Page")
("page.guardrails", "route", "guardrails.html")
("page.guardrails", "role", "guardrails")
("page.guardrails", "title", "Guardrails — Perth Encounter")
("page.guardrails", "description", "The humane guardrails for Perth Encounter.")
("page.guardrails", "kicker", "Guardrails")
("page.guardrails", "heading", "The enemy says X. We answer Y.")
("page.guardrails", "intro", "The accuser is the voice that turns fear into control. The answer is not domination with a nicer name; it is service with boundaries.")
("page.guardrails", "section", "section.guardrails.boundaries")
("page.guardrails", "section", "section.guardrails.safety")
("section.guardrails.boundaries", "isa", "Section")
("section.guardrails.boundaries", "page", "page.guardrails")
("section.guardrails.boundaries", "label", "Operational independence")
("section.guardrails.boundaries", "heading", "Independent enough to protect; open enough to be corrected")
("section.guardrails.boundaries", "prose", "No separation from society. No secret inner circle. We keep operational boundaries for safety, finances and data while remaining answerable to churches, partners and the public.")
("section.guardrails.safety", "isa", "Section")
("section.guardrails.safety", "page", "page.guardrails")
("section.guardrails.safety", "label", "Human first")
("section.guardrails.safety", "heading", "Consent, safeguarding and freedom to leave")
("section.guardrails.safety", "prose", "No coercive altar calls, staged miracles, spiritual pressure, financial manipulation or claims that dissent is disobedience. Any person can pause, leave, disagree or ask for help.")

("page.testimony", "isa", "Page")
("page.testimony", "route", "testimony.html")
("page.testimony", "role", "testimony")
("page.testimony", "title", "Aaron's testimony — Perth Encounter")
("page.testimony", "description", "Aaron's personal testimony behind Perth Encounter — 7/7/27.")
("page.testimony", "kicker", "A personal testimony")
("page.testimony", "heading", "I believe.")
("page.testimony", "intro", "I believe we need to make a better offering because we have more capacity than wisdom, and because power only becomes trustworthy when it is willing to empty itself for the good of another.")
("page.testimony", "section", "section.testimony.bledsoe")
("page.testimony", "section", "section.testimony.boundary")
("section.testimony.bledsoe", "isa", "Section")
("section.testimony.bledsoe", "page", "page.testimony")
("section.testimony.bledsoe", "label", "Bledsoe")
("section.testimony.bledsoe", "heading", "A name inside the history")
("section.testimony.bledsoe", "prose", "Bledsoe belongs to the history of how I came to this point. I name that honestly without turning a private relationship into public evidence or asking another person to carry my meaning.")
("section.testimony.boundary", "isa", "Section")
("section.testimony.boundary", "page", "page.testimony")
("section.testimony.boundary", "label", "The boundary")
("section.testimony.boundary", "heading", "Testimony is not authority")
("section.testimony.boundary", "prose", "This is what I honestly believe. It is an invitation to think, pray, test and choose—not a command, diagnosis, prophecy or claim to control anyone else's conscience.")

