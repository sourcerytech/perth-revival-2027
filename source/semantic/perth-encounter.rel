("section.home.invitation", "isa", "Section")
("section.home.invitation", "page", "page.home")
("section.home.invitation", "label", "01 / The invitation")
("section.home.invitation", "heading", "Two stories. One offering.")
("section.home.invitation", "lead", "Perth Encounter is a night of prayer, worship, lament, reconciliation and practical mercy beside the Derbarl Yerrigan / Swan River.")
("section.home.invitation", "prose", "It grew from one person's search for God, truth, love and responsible power. It is now offered beyond one person: to Perth's churches, communities, musicians and neighbours as one night given to God.")
("section.home.invitation", "prose", "Its kenotic centre is simple: power is most trustworthy when it serves rather than dominates. We take revelation seriously without turning testimony into control, and we make room for doubt, conscience and honest disagreement.")
("section.home.invitation", "quote", "The power of revival is not how many people fall down, but how many burdens are lifted when we stand.")
("section.home.invitation", "order", "10")

("section.home.architecture", "isa", "Section")
("section.home.architecture", "page", "page.home")
("section.home.architecture", "label", "02 / The architecture")
("section.home.architecture", "heading", "Receive seriously. Test openly.")
("section.home.architecture", "prose", "The event is the visible summit of a larger offering: a humane architecture for worship, discernment, cooperation and repair.")
("section.home.architecture", "prose", "The story, the commons and the guardrails are three views over one offering. None is a command to join a new religion.")
("section.home.architecture", "order", "20")

("section.home.posture", "isa", "Section")
("section.home.posture", "page", "page.home")
("section.home.posture", "label", "02 / The posture")
("section.home.posture", "heading", "Four ways to make room")
("section.home.posture", "item", "item.posture.room")
("section.home.posture", "item", "item.posture.burdens")
("section.home.posture", "item", "item.posture.honest")
("section.home.posture", "item", "item.posture.return")
("section.home.posture", "order", "30")
("item.posture.room", "isa", "Principle")
("item.posture.room", "label", "01")
("item.posture.room", "heading", "Make room")
("item.posture.room", "prose", "Silence, consent, accessibility and honest disagreement remain part of the gathering.")
("item.posture.burdens", "isa", "Principle")
("item.posture.burdens", "label", "02")
("item.posture.burdens", "heading", "Lift burdens")
("item.posture.burdens", "prose", "Prayer is joined to food, listening, support services, reconciliation and material care.")
("item.posture.honest", "isa", "Principle")
("item.posture.honest", "label", "03")
("item.posture.honest", "heading", "Keep faith honest")
("item.posture.honest", "prose", "No staged miracles, coercive calls, prosperity promises or claims that tragedy is personal guilt.")
("item.posture.return", "isa", "Principle")
("item.posture.return", "label", "04")
("item.posture.return", "heading", "Return changed")
("item.posture.return", "prose", "The measure is not intensity in the room, but repair that continues in Perth after the lights go down.")

("section.home.night", "isa", "ProcessProjection")
("section.home.night", "page", "page.home")
("section.home.night", "label", "03 / The night")
("section.home.night", "heading", "Seven movements toward morning.")
("section.home.night", "prose", "Proposed riverfront setting near Elizabeth Quay / Langley Park, subject to permits, local leadership and final safety planning.")
("section.home.night", "item", "stage.admission")
("section.home.night", "item", "stage.carrier")
("section.home.night", "item", "stage.invariant")
("section.home.night", "item", "stage.transport")
("section.home.night", "item", "stage.selection")
("section.home.night", "item", "stage.record")
("section.home.night", "order", "40")
("stage.admission", "isa", "ProcessStage")
("stage.admission", "time", "4:00")
("stage.admission", "heading", "The Mercy Commons")
("stage.admission", "prose", "Free food, quiet space, prayer, local support services and a welcome without a sales pitch.")
("stage.admission", "order", "1")
("stage.carrier", "isa", "ProcessStage")
("stage.carrier", "time", "5:30")
("stage.carrier", "heading", "Stories of repair")
("stage.carrier", "prose", "Short testimonies from people working for recovery, belonging, justice and reconciliation across Perth.")
("stage.carrier", "order", "2")
("stage.invariant", "isa", "ProcessStage")
("stage.invariant", "time", "6:30")
("stage.invariant", "heading", "The city listens")
("stage.invariant", "prose", "Lament, confession and prayers for those carrying grief, exclusion, illness and fear.")
("stage.invariant", "order", "3")
("stage.transport", "isa", "ProcessStage")
("stage.transport", "time", "7:07")
("stage.transport", "heading", "The kenotic moment")
("stage.transport", "prose", "Seven minutes where leaders relinquish the stage. Sit, kneel or stand. No one is watched for the right response.")
("stage.transport", "order", "4")
("stage.selection", "isa", "ProcessStage")
("stage.selection", "time", "7:14")
("stage.selection", "heading", "Seven acts of release")
("stage.selection", "prose", "Forgiveness, debt relief, hospitality, child protection, care for country, reconciliation and service.")
("stage.selection", "order", "5")
("stage.record", "isa", "ProcessStage")
("stage.record", "time", "9:00")
("stage.record", "heading", "Sent into the city")
("stage.record", "prose", "One apology. One generous act. One repaired relationship. One hour of service. Seven days to begin.")
("stage.record", "order", "7")

("section.home.algebra", "isa", "Section")
("section.home.algebra", "page", "page.home")
("section.home.algebra", "label", "04 / A way of living")
("section.home.algebra", "heading", "What we release, what we receive.")
("section.home.algebra", "prose", "Kenosis is not disappearing. It is choosing not to take up all the room. We loosen our grip, make space for another person, and let love become something that can be recognised in the way we live.")
("section.home.algebra", "equation", "welcome → listen → release → receive → repair → return")
("section.home.algebra", "order", "50")

("section.home.join", "isa", "Section")
("section.home.join", "page", "page.home")
("section.home.join", "label", "05 / Keep the flame")
("section.home.join", "heading", "Bring your whole self.")
("section.home.join", "prose", "Register interest for updates, volunteer pathways and community partnership conversations. Registration is free and creates no obligation.")
("section.home.join", "order", "60")

("section.home.sources", "isa", "Section")
("section.home.sources", "page", "page.home")
("section.home.sources", "label", "06 / Source posture")
("section.home.sources", "heading", "Grounded in careful hope.")
("section.home.sources", "prose", "The site draws on the local Claimipedia capture and repository corpus as interpretive sources, not as proof of a religious event. The process algebra is a guardrail for humility, not a language the crowd has to learn.")
("section.home.sources", "order", "70")

("page.story", "isa", "Page")
("page.story", "route", "story.html")
("page.story", "role", "story")
("page.story", "title", "The story — Perth Encounter")
("page.story", "description", "The story behind Perth Encounter — 7/7/27.")
("page.story", "kicker", "The story")
("page.story", "heading", "Two stories. One offering.")
("page.story", "intro", "This is Aaron's testimony, held alongside the wider story it cannot control.")
("page.story", "section", "section.story.aaron")
("page.story", "section", "section.story.wider")
("page.story", "section", "section.story.receive")
("section.story.aaron", "isa", "Section")
("section.story.aaron", "page", "page.story")
("section.story.aaron", "label", "Aaron's account")
("section.story.aaron", "heading", "A search that became an offering")
("section.story.aaron", "prose", "I believe we need to make room for God, for one another and for honest uncertainty, because power without surrender becomes coercion. This event is not a command to follow me; it is the best offering I know how to make.")
("section.story.aaron", "prose", "The testimony includes Bledsoe as part of the personal history and the questions that shaped this work. It is offered with boundaries: no diagnosis, no private claim over another person, no demand that anyone accept my interpretation.")
("section.story.wider", "isa", "Section")
("section.story.wider", "page", "page.story")
("section.story.wider", "label", "The wider story")
("section.story.wider", "heading", "From creation to now")
("section.story.wider", "prose", "The kenotic reading looks for self-giving across the stories we inherit: creation, Israel, Jesus, Pentecost, emancipation, science, technology and the ordinary work of repair.")
("section.story.receive", "isa", "Section")
("section.story.receive", "page", "page.story")
("section.story.receive", "label", "Receive seriously")
("section.story.receive", "heading", "Test openly")
("section.story.receive", "prose", "A meaningful story should become more humane when it is tested. The event leaves room for disagreement, local leadership, independent safeguarding and the possibility that some hopes will not be fulfilled.")

("page.commons", "isa", "Page")
