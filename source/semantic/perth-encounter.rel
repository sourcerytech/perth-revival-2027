("item.posture.room", "isa", "Principle")
("item.posture.room", "label", "01")
("item.posture.room", "heading", "Make room")
("item.posture.room", "prose", "Silence, consent, accessibility and honest disagreement remain part of the gathering.")
("item.posture.burdens", "isa", "Principle")
("item.posture.burdens", "label", "02")
("item.posture.burdens", "heading", "Lift burdens")
("item.posture.burdens", "prose", "Prayer is joined to food, listening, support services, reconciliation and material care.")
("item.posture.honest", "isa", "Principle")
("item.posture.honest", "label", "03")
("item.posture.honest", "heading", "Keep faith honest")
("item.posture.honest", "prose", "No staged miracles, coercive calls, prosperity promises or claims that tragedy is personal guilt.")
("item.posture.return", "isa", "Principle")
("item.posture.return", "label", "04")
("item.posture.return", "heading", "Return changed")
("item.posture.return", "prose", "The measure is not intensity in the room, but repair that continues in Perth after the lights go down.")

