("page.home", "heading", "Perth Encounter")
("page.home", "intro", "One night, given to God: worship, prayer, beauty and practical love offered without asking anyone to surrender their conscience.")
("page.home", "note", "Bring your best. Leave the centre open. Return with repair.")
("page.home", "section", "section.home.invitation")
