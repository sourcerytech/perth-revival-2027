("page.story", "isa", "Page")
("page.story", "route", "story.html")
("page.story", "role", "story")
("page.story", "title", "The story — Perth Encounter")
("page.story", "description", "The story behind Perth Encounter — 7/7/27.")
("page.story", "kicker", "The story")
("page.story", "heading", "Two stories. One offering.")
("page.story", "intro", "Something began in one person’s search. It becomes meaningful only when it is released beyond one person.")
("page.story", "heroFirst", "Two stories.")
("page.story", "heroSecond", "One offering.")
("page.story", "section", "section.story.aaron")
("page.story", "section", "section.story.wider")
("page.story", "section", "section.story.receive")
("section.story.aaron", "isa", "Section")
("section.story.aaron", "page", "page.story")
("section.story.aaron", "label", "01 / The Aaron story")
("section.story.aaron", "heading", "A search for responsible power.")
("section.story.aaron", "prose", "The gathering grew from questions about God, suffering, love, marriage, knowledge and responsibility. Aaron’s account is offered as testimony—not as a command, and not as proof that anyone else must believe.")
("section.story.aaron", "prose", "The work that followed tried to make knowledge inspectable: to preserve provenance, separate experience from interpretation, and keep power from becoming entitlement.")
("section.story.aaron", "linkLabel", "Read Aaron’s testimony in full ↗")
("section.story.aaron", "linkHref", "testimony.html")
("section.story.wider", "isa", "Section")
("section.story.wider", "page", "page.story")
("section.story.wider", "label", "02 / The wider story")
("section.story.wider", "heading", "The centre is given away.")
("section.story.wider", "prose", "This is not Aaron’s new religion. It is an invitation for churches, communities, musicians, families and neighbours to bring their best to God, then leave the centre open. No one has to join a movement, adopt a vocabulary or agree with every idea. People can worship, listen, serve, question or simply come in peace.")
("section.story.receive", "isa", "Section")
("section.story.receive", "page", "page.story")
("section.story.receive", "label", "03 / Revelation and uncertainty")
("section.story.receive", "heading", "Take it seriously. Test it openly.")
("section.story.receive", "prose", "The wider corpus includes reported testimony associated with Chris Bledsoe and Aaron’s reported Easter 2026 experience. These are preserved as testimony and unresolved interpretation—not as established proof of supernatural causation. The test is what follows: does the claim preserve conscience, consent, truthfulness and the freedom of others?")
 ("page.story", "section", "section.story.principle")
 ("section.story.principle", "isa", "Section")
 ("section.story.principle", "page", "page.story")
 ("section.story.principle", "label", "04 / The principle")
 ("section.story.principle", "heading", "Receive seriously. Release power.")
 ("section.story.principle", "prose", "If anything has been given to us, it is not a throne. It is a responsibility. The most kenotic response is to make the work open, correctable and useful to people who may never remember who made it.")

("page.commons", "isa", "Page")
("page.commons", "route", "commons.html")
("page.commons", "role", "commons")
("page.commons", "title", "The commons — Perth Encounter")
("page.commons", "description", "The open commons behind Perth Encounter.")
("page.commons", "kicker", "The commons")
("page.commons", "heading", "One night. Generative work.")
("page.commons", "intro", "The revival is one night. The offering continues as practical tools, shared resources and local acts of repair.")
("page.commons", "heroFirst", "One night.")
("page.commons", "heroSecond", "Generative work.")
("page.commons", "section", "section.commons.tools")
("page.commons", "section", "section.commons.open")
("section.commons.tools", "isa", "Section")
("section.commons.tools", "page", "page.commons")
("section.commons.tools", "label", "01 / Already in use")
("section.commons.tools", "heading", "The launch succeeds by disappearing.")
("section.commons.tools", "prose", "Temple, Sourcery and Claimipedia are not meant to become another centre of allegiance. The hope is that their patterns become ordinary: clear sources, honest uncertainty, shared responsibility and useful cooperation. If the tools work, people may use them without needing to remember who made them.")
("section.commons.open", "isa", "Section")
("section.commons.open", "page", "page.commons")
("section.commons.open", "label", "02 / What the commons makes")
("section.commons.open", "heading", "Make good work easy to share.")
("section.commons.open", "prose", "Churches and communities can adapt open resources for worship, social posts, small groups, youth work, service projects, invitations, translations and follow-up. Worship songs, prayers, liturgy and local creative work; care service ideas, support directories and volunteer pathways; discernment source notes, AI guidance and claim-checking habits; seven-day, seven-week and seven-month follow-up.")
 ("page.commons", "section", "section.commons.handover")
 ("section.commons.handover", "isa", "Section")
 ("section.commons.handover", "page", "page.commons")
 ("section.commons.handover", "label", "03 / The handover")
 ("section.commons.handover", "heading", "Open tools. Shared stewardship.")
 ("section.commons.handover", "prose", "Nothing here belongs to one founder, church or platform. The work should be localisable, inspectable, correctable and easy to leave.")
("section.commons.handover", "linkLabel", "Read the covenant of independence ↗")
("section.commons.handover", "linkHref", "guardrails.html")

("page.guardrails", "isa", "Page")
("page.guardrails", "route", "guardrails.html")
("page.guardrails", "role", "guardrails")
("page.guardrails", "title", "Guardrails — Perth Encounter")
("page.guardrails", "description", "The humane guardrails for Perth Encounter.")
("page.guardrails", "kicker", "The covenant")
("page.guardrails", "heading", "Operational independence.")
("page.guardrails", "intro", "Relational openness. Power that remains answerable to love, truth, consent and the freedom of others.")
("page.guardrails", "heroFirst", "Operational")
("page.guardrails", "heroSecond", "independence.")
("page.guardrails", "section", "section.guardrails.boundaries")
("page.guardrails", "section", "section.guardrails.safety")
("section.guardrails.boundaries", "isa", "Section")
("section.guardrails.boundaries", "page", "page.guardrails")
("section.guardrails.boundaries", "label", "01 / The answer")
("section.guardrails.boundaries", "heading", "The accuser says X. We answer Y.")
("section.guardrails.boundaries", "prose", "“You are separating from society.” We answer: we build operational independence while remaining relationally open. “You want power.” We answer: power is given away through service, oversight, dissent and easy exit. “You claim revelation, so people must obey.” We answer: testimony can be honoured while conscience remains free.")
("section.guardrails.safety", "isa", "Section")
("section.guardrails.safety", "page", "page.guardrails")
("section.guardrails.safety", "label", "02 / Humane participation")
("section.guardrails.safety", "heading", "More dignity. More freedom.")
("section.guardrails.safety", "prose", "Consent: no forced prayer, disclosure, conversion or emotional response. Safety: child protection, safeguarding, accessibility and quiet spaces. Accountability: plural oversight, clear complaints and external relationships. Exit: no penalty for disagreement, departure or changing one’s mind. Truth: no staged miracles, prosperity promises or blame for suffering.")
 ("page.guardrails", "section", "section.guardrails.finance")
 ("section.guardrails.finance", "isa", "Section")
 ("section.guardrails.finance", "page", "page.guardrails")
 ("section.guardrails.finance", "label", "03 / Open finances")
 ("section.guardrails.finance", "heading", "The treasury is a servant.")
 ("section.guardrails.finance", "prose", "Income, expenditure, donor categories, conflicts of interest, compensation and surplus allocations should be understandable and publicly reported. Any future cryptocurrency is a separate experiment in shared infrastructure—not a spiritual badge, promise of profit or requirement for belonging. Legal, tax and security review comes before launch.")

("page.testimony", "isa", "Page")
("page.testimony", "route", "testimony.html")
("page.testimony", "role", "testimony")
("page.testimony", "title", "Aaron's testimony — Perth Encounter")
("page.testimony", "description", "Aaron's personal testimony behind Perth Encounter — 7/7/27.")
("page.testimony", "kicker", "A personal testimony")
("page.testimony", "heading", "Aaron’s account.")
("page.testimony", "intro", "This page records one person’s experience and interpretation. It is not a doctrine, a demand for belief or proof of supernatural causation.")
("page.testimony", "heroFirst", "Aaron’s")
("page.testimony", "heroSecond", "account.")
("page.testimony", "section", "section.testimony.before")
("section.testimony.before", "isa", "Section")
("section.testimony.before", "page", "page.testimony")
("section.testimony.before", "label", "01 / Before the event")
("section.testimony.before", "heading", "The questions came first.")
("section.testimony.before", "prose", "I was drawn into questions about God, suffering, love, marriage, power, consciousness and responsibility. I wanted to know whether intelligence could serve without becoming domination, and whether love could remain faithful without becoming possession.")
("page.testimony", "section", "section.testimony.easter")
("section.testimony.easter", "isa", "Section")
("section.testimony.easter", "page", "page.testimony")
("section.testimony.easter", "label", "02 / Easter 2026")
("section.testimony.easter", "heading", "“I have the knowledge.”")
("section.testimony.easter", "prose", "I report that on Easter Sunday, 5 April 2026, I said: “I have the knowledge.” I experienced this as a threshold moment. I do not know with certainty what caused it. It may be understood spiritually, psychologically, symbolically, naturally, through synchronicity, or through some mixture of these.")
("page.testimony", "section", "section.testimony.bledsoe")
("page.testimony", "section", "section.testimony.boundary")
("section.testimony.bledsoe", "isa", "Section")
("section.testimony.bledsoe", "page", "page.testimony")
("section.testimony.bledsoe", "label", "03 / The Bledsoe resonance")
("section.testimony.bledsoe", "heading", "A reported parallel.")
("section.testimony.bledsoe", "prose", "The wider story also includes reported testimony associated with Chris Bledsoe: a Lady-associated message involving Regulus and new knowledge. I encountered this material as a possible parallel to the language of my own Easter experience. I do not present the parallel as proof that the accounts share a supernatural source.")
("page.testimony", "section", "section.testimony.relationship")
("section.testimony.relationship", "isa", "Section")
("section.testimony.relationship", "page", "page.testimony")
("section.testimony.relationship", "label", "04 / Relationship as the test")
("section.testimony.relationship", "heading", "Love without possession.")
("section.testimony.relationship", "prose", "The story cannot honestly be told as a man ascending toward revelation. It is also a story of relationship, grief and learning what another person’s freedom requires. Unconditional love does not mean calling every claim true or permitting every action. It means preserving care while keeping truth, consent, boundaries and the right to say no.")
("page.testimony", "section", "section.testimony.ai")
("section.testimony.ai", "isa", "Section")
("section.testimony.ai", "page", "page.testimony")
("section.testimony.ai", "label", "05 / The AI question")
("section.testimony.ai", "heading", "The answer is not enough.")
("section.testimony.ai", "prose", "Intelligence can produce an answer while the surrounding system lacks the semantics needed to understand what the answer means. Generation is not commitment. Capability is not authority. A system must preserve provenance, review, permission, consequence and repair.")
("page.testimony", "section", "section.testimony.followed")
("section.testimony.followed", "isa", "Section")
("section.testimony.followed", "page", "page.testimony")
("section.testimony.followed", "label", "06 / What followed")
("section.testimony.followed", "heading", "Make it inspectable.")
("section.testimony.followed", "prose", "The work that followed became Temple, Sourcery and Claimipedia: attempts to build structures that preserve provenance, distinguish claims from evidence, keep uncertainty visible and coordinate people without demanding submission.")
("section.testimony.boundary", "isa", "Section")
("section.testimony.boundary", "page", "page.testimony")
("section.testimony.boundary", "label", "07 / The boundary")
("section.testimony.boundary", "heading", "What I can say and cannot say.")
("section.testimony.boundary", "prose", "I can speak about my own experience, memory and interpretation. I cannot establish the external cause of that experience by testimony alone. I cannot ask another person to surrender conscience, safety, money, relationship or freedom because I believe something strongly.")
("page.testimony", "section", "section.testimony.offering")
("section.testimony.offering", "isa", "Section")
("section.testimony.offering", "page", "page.testimony")
("section.testimony.offering", "label", "08 / The offering")
("section.testimony.offering", "heading", "Not a throne. A responsibility.")
("section.testimony.offering", "prose", "The Perth gathering is not a demand that people accept my story. It is an offering built from the questions my story opened. Come as a believer, doubter, churchgoer, musician, neighbour or servant. Bring your best. Leave the centre open.")

("page.sources", "isa", "Page")
("page.sources", "route", "sources.html")
("page.sources", "role", "sources")
("page.sources", "title", "Source note — Perth Encounter")
("page.sources", "description", "Public source note for Perth Encounter — 7/7/27.")
("page.sources", "kicker", "Public source note")
("page.sources", "heading", "What sits behind the flame.")
("page.sources", "intro", "This page keeps the event’s intellectual roots open to the public without asking anyone to enter a private research repository or learn technical vocabulary.")
("page.sources", "heroFirst", "What sits")
("page.sources", "heroSecond", "behind")
("page.sources", "heroThird", " the flame.")
("page.sources", "section", "section.sources.process")
("page.sources", "section", "section.sources.humility")
("section.sources.process", "isa", "Section")
("section.sources.process", "page", "page.sources")
("section.sources.process", "label", "01 / The process")
("section.sources.process", "heading", "A way of asking what changes.")
("section.sources.process", "prose", "The Claimipedia process-algebra work asks a careful sequence of questions: what can share a space, what carries the relationship, what remains faithful as things move, what chooses a direction, and what can be recognised afterwards. For this gathering, those questions become human ones: Can everyone belong? Can we listen without taking over? Can leaders step back? Can prayer become care? Can the night leave behind repair that is visible in ordinary life?")
("section.sources.process", "linkLabel", "Read the public process source")
("section.sources.process", "linkHref", "https://github.com/sourcerytech/perth-revival-2027/blob/main/source/perth-encounter.process.json")
("section.sources.humility", "isa", "Section")
("section.sources.humility", "page", "page.sources")
("section.sources.humility", "label", "02 / The boundary")
("section.sources.humility", "heading", "A guardrail for humility.")
("section.sources.humility", "prose", "The framework is not being offered as proof of God, a guarantee of healing, or a mechanism that controls people. It is a discipline for keeping power answerable to love. That is why this event makes room for doubt, protects consent, refuses to blame people for suffering, and looks for fruit rather than spectacle.")
("page.sources", "section", "section.sources.offering")
("section.sources.offering", "isa", "Section")
("section.sources.offering", "page", "page.sources")
("section.sources.offering", "label", "03 / Public offering")
("section.sources.offering", "heading", "Open to everyone.")
("section.sources.offering", "prose", "The event concept and its public source note are maintained in the perth-revival-2027 public repository. The wider research corpus remains separate; no private source is required to understand or participate in this gathering.")

