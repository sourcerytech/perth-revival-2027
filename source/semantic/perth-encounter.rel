("section.home.invitation", "isa", "Section")
("section.home.invitation", "page", "page.home")
("section.home.invitation", "label", "01 / The invitation")
("section.home.invitation", "heading", "Two stories. One offering.")
("section.home.invitation", "lead", "Perth Encounter is a night of prayer, worship, lament, reconciliation and practical mercy beside the Derbarl Yerrigan / Swan River.")
("section.home.invitation", "prose", "It grew from one person's search for God, truth, love and responsible power. It is now offered beyond one person: to Perth's churches, communities, musicians and neighbours as one night given to God.")
("section.home.invitation", "prose", "Its kenotic centre is simple: power is most trustworthy when it serves rather than dominates. We take revelation seriously without turning testimony into control, and we make room for doubt, conscience and honest disagreement.")
("section.home.invitation", "quote", "The power of revival is not how many people fall down, but how many burdens are lifted when we stand.")
("section.home.invitation", "order", "10")

("section.home.architecture", "isa", "Section")
("section.home.architecture", "page", "page.home")
("section.home.architecture", "label", "02 / The architecture")
("section.home.architecture", "heading", "Receive seriously. Test openly.")
("section.home.architecture", "prose", "The event is the visible summit of a larger offering: a humane architecture for worship, discernment, cooperation and repair.")
("section.home.architecture", "prose", "The story, the commons and the guardrails are three views over one offering. None is a command to join a new religion.")
("section.home.architecture", "order", "20")

("section.home.posture", "isa", "Section")
("section.home.posture", "page", "page.home")
("section.home.posture", "label", "02 / The posture")
("section.home.posture", "heading", "Four ways to make room")
("section.home.posture", "item", "item.posture.room")
("section.home.posture", "item", "item.posture.burdens")
