// Operational contract for routes, accessibility, assets and participation.
("contract.perthEncounter", "isa", "SiteContract")
("contract.perthEncounter", "site", "site.perthEncounter")
("contract.perthEncounter", "requirement", "requirement.one-main")
("contract.perthEncounter", "requirement", "requirement.one-h1")
("contract.perthEncounter", "requirement", "requirement.named-controls")
("contract.perthEncounter", "requirement", "requirement.focus-visible")
("contract.perthEncounter", "assetRole", "asset.hero")
("contract.perthEncounter", "assetRole", "asset.favicon")
("contract.perthEncounter", "assetRole", "asset.social")
("contract.perthEncounter", "protocol", "protocol.signup")
("requirement.one-main", "isa", "AccessibilityRequirement")
("requirement.one-main", "rule", "exactly one main landmark")
("requirement.one-h1", "isa", "AccessibilityRequirement")
("requirement.one-h1", "rule", "exactly one visible h1")
("requirement.named-controls", "isa", "AccessibilityRequirement")
("requirement.named-controls", "rule", "every interactive control has an accessible name")
("requirement.focus-visible", "isa", "AccessibilityRequirement")
("requirement.focus-visible", "rule", "keyboard focus remains visible")
("asset.hero", "isa", "AssetRole")
("asset.hero", "path", "assets/perth-revival.jpg")
("asset.hero", "required", "true")
("asset.favicon", "isa", "AssetRole")
("asset.favicon", "path", "assets/favicon.svg")
("asset.favicon", "required", "true")
("asset.social", "isa", "AssetRole")
("asset.social", "path", "assets/social-card.png")
("asset.social", "required", "true")
("protocol.signup", "isa", "InteractionProtocol")
("protocol.signup", "request", "signup.request")
("protocol.signup", "success", "signup.success")
("protocol.signup", "failure", "signup.failure")
("protocol.signup", "refusal", "signup.refusal")
("signup.request", "isa", "ProtocolState")
("signup.request", "meaning", "A visitor submits an email and explicit consent.")
("signup.success", "isa", "ProtocolState")
("signup.success", "meaning", "The notification is accepted and the visitor is told clearly.")
("signup.failure", "isa", "ProtocolState")
("signup.failure", "meaning", "Delivery fails without claiming success.")
("signup.refusal", "isa", "ProtocolState")
("signup.refusal", "meaning", "Invalid email, absent consent or disallowed origin is refused.")

// Public content anchors are contract facts, not build-script literals.
("page.home", "contentAnchor", "One night, given to God")
("page.story", "contentAnchor", "Two stories.")
("page.story", "contentAnchor", "Test it openly")
("page.commons", "contentAnchor", "One night.")
("page.commons", "contentAnchor", "Make good work easy to share.")
("page.guardrails", "contentAnchor", "Operational independence.")
("page.guardrails", "contentAnchor", "The accuser says X.")
("page.testimony", "contentAnchor", "Aaron’s account.")
("page.testimony", "contentAnchor", "Bledsoe")
("page.sources", "contentAnchor", "What sits")
("page.sources", "contentAnchor", "process-algebra")
("page.privacy", "contentAnchor", "Your details stay human.")
("page.privacy", "contentAnchor", "Email and consent.")
("page.contact", "contentAnchor", "Bring a question.")
("page.contact", "contentAnchor", "Safety is everyone’s work.")
