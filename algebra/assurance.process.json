{
  "queries": {
    "assurance.page": [
      {
        "assert": [
          "eq",
          "$inspection.main",
          1
        ],
        "message": "Page must have one main [TEMPLE-A001]. Boundary: document landmarks. Correct the shared DOM projection in algebra/dom.process.json; regenerate output and rerun the isolated bootstrap proof."
      },
      {
        "assert": [
          "eq",
          "$inspection.h1",
          1
        ],
        "message": "Page must have one h1 [TEMPLE-A002]. Boundary: page heading structure. Correct the semantic page or its DOM projection; regenerate output and rerun the isolated bootstrap proof."
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$inspection.duplicateIds"
          ],
          0
        ],
        "message": "Duplicate element ids [TEMPLE-A003]. Boundary: document identity. Correct authored ids or projection identity generation; do not patch generated HTML. Rerun the isolated bootstrap proof."
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$inspection.unnamed"
          ],
          0
        ],
        "message": "Unnamed controls [TEMPLE-A004]. Boundary: accessible control names. Supply an authored visible label or accessible name through the projection; rerun the isolated bootstrap proof and browser accessibility checks."
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$inspection.navigation"
          ],
          1
        ],
        "message": "Primary navigation missing or duplicated [TEMPLE-A005]. Boundary: shared navigation ownership. Restore the single shared navigation projection; do not copy a header into individual pages. Rerun the isolated bootstrap proof."
      },
      {
        "assert": [
          "eq",
          [
            "at",
            "$inspection.navigation",
            0
          ],
          [
            "map",
            [
              "objects",
              "site.perthEncounter",
              "navigation"
            ],
            "nav",
            {
              "href": [
                "one",
                "$nav",
                "href"
              ],
              "label": [
                "one",
                "$nav",
                "label"
              ]
            }
          ]
        ],
        "message": "Shared navigation drift"
      }
    ],
    "assurance.html": [
      {
        "each": [
          "objects",
          "$page",
          "contentAnchor"
        ],
        "as": "anchor",
        "steps": [
          {
            "assert": [
              "includes",
              "$html",
              "$anchor"
            ],
            "message": "Required content anchor missing"
          }
        ]
      }
    ],
    "assurance.links": [
      {
        "each": "$rendered",
        "as": "document",
        "steps": [
          {
            "each": "$document.links",
            "as": "href",
            "steps": [
              {
                "port": "url.resolve",
                "args": {
                  "href": "$href",
                  "route": "$document.route"
                },
                "into": "link"
              },
              {
                "when": [
                  "not",
                  "$link.external"
                ],
                "then": [
                  {
                    "let": "target",
                    "value": [
                      "at",
                      [
                        "filter",
                        "$rendered",
                        "candidate",
                        [
                          "eq",
                          "$candidate.route",
                          "$link.route"
                        ]
                      ],
                      0
                    ]
                  },
                  {
                    "assert": [
                      "eq",
                      [
                        "count",
                        [
                          "filter",
                          "$rendered",
                          "candidate",
                          [
                            "eq",
                            "$candidate.route",
                            "$link.route"
                          ]
                        ]
                      ],
                      1
                    ],
                    "message": "Local link target is missing [TEMPLE-A006]. Boundary: authored routes. Correct the source route or link and regenerate all pages; do not create a generated placeholder. Rerun the isolated bootstrap proof."
                  },
                  {
                    "when": "$link.fragment",
                    "then": [
                      {
                        "assert": [
                          "includes",
                          "$target.ids",
                          "$link.fragment"
                        ],
                        "message": "Local fragment is missing [TEMPLE-A007]. Boundary: authored anchor identity. Align the source link fragment with its projected target id; regenerate and rerun the isolated bootstrap proof."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "protocol": "temple/surface-process-module/1"
}
